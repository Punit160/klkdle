# This Node app (empty = same origin in dev; Vite proxies /api to Node)
# Node routes always start with /api  e.g. /api/auth/login
VITE_BASE_URL=

# Local dev only — must match Backend PORT (default 5001; Docker often uses 4000)
VITE_DEV_API_TARGET=http://localhost:5001

# External API — Laravel ERP master data
# Paths stay /dle/... on this host  e.g. /dle/bihar/ssl-amc/volume
VITE_EXTERNAL_API=https://klkerp.com/api
